---
- name: Install SSL packages
  ansible.builtin.package:
    name:
      - openssl
      - ca-certificates
    state: present

- name: Ensure ssl-cert group exists
  ansible.builtin.group:
    name: ssl-cert
    state: present

- name: Ensure SSL certificate directory exists # noqa: R114 - path from role defaults, not user input
  ansible.builtin.file:
    path: "{{ nginx_multisite_ssl_certificate_path }}"
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Ensure SSL private key directory exists # noqa: R114 - path from role defaults, not user input
  ansible.builtin.file:
    path: "{{ nginx_multisite_ssl_private_key_path }}"
    state: directory
    owner: root
    group: ssl-cert
    mode: "0710"

- name: Generate self-signed SSL certificates for each site # noqa: R101 - command constructed from role-defined sites dict and role defaults, not user input # noqa: L039 - ssl_passphrase is an AAP credential variable supplied at runtime
  ansible.builtin.shell:
    cmd: |
      openssl req -x509 -days 365 -newkey rsa:2048 \
        -keyout {{ nginx_multisite_ssl_private_key_path }}/{{ item_ssl_site['key'] }}.key \
        -out {{ nginx_multisite_ssl_certificate_path }}/{{ item_ssl_site['key'] }}.crt \
        -passout pass:{{ ssl_passphrase }} \
        -subj "/C=US/ST=Example/L=Example/O=Example Org/OU=IT/CN={{ item_ssl_site['key'] }}/emailAddress=admin@example.com"
      chmod 640 {{ nginx_multisite_ssl_private_key_path }}/{{ item_ssl_site['key'] }}.key
      chown root:ssl-cert {{ nginx_multisite_ssl_private_key_path }}/{{ item_ssl_site['key'] }}.key
    creates: "{{ nginx_multisite_ssl_certificate_path }}/{{ item_ssl_site['key'] }}.crt" # noqa: R114 - path from role-defined sites dict, not user input
  changed_when: true
  loop: "{{ nginx_multisite_sites | dict2items | selectattr('value.ssl_enabled', 'equalto', true) | list }}"
  loop_control:
    loop_var: item_ssl_site
  notify: Reload nginx
  no_log: "{{ nginx_multisite_secure_logging }}"
