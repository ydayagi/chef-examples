argument_specs:
  main:
    short_description: Install and configure nginx as a multi-site SSL web server with host hardening
    description:
      - Installs and configures nginx to serve multiple SSL-enabled virtual hosts.
      - Hardens the host with fail2ban, UFW firewall, sysctl kernel parameters, and SSH daemon settings.
      - Generates self-signed TLS certificates for each configured virtual host.
      - Fetches an OAuth access token from a configurable endpoint.
    options:
      nginx_multisite_sites:
        type: dict
        required: false
        default:
          test.cluster.local:
            document_root: /opt/server/test
            ssl_enabled: true
          ci.cluster.local:
            document_root: /opt/server/ci
            ssl_enabled: true
          status.cluster.local:
            document_root: /opt/server/status
            ssl_enabled: true
        description: >-
          Dictionary of virtual host configurations keyed by server name.
          Each entry must have document_root (str) and ssl_enabled (bool).
      nginx_multisite_ssl_certificate_path:
        type: str
        required: false
        default: /etc/ssl/certs
        description: Directory path where SSL certificates (.crt files) are stored.
      nginx_multisite_ssl_private_key_path:
        type: str
        required: false
        default: /etc/ssl/private
        description: Directory path where SSL private keys (.key files) are stored.
      nginx_multisite_fail2ban_enabled:
        type: bool
        required: false
        default: true
        description: Whether to install and configure fail2ban intrusion prevention.
      nginx_multisite_ufw_enabled:
        type: bool
        required: false
        default: true
        description: Whether to configure UFW firewall rules (deny-by-default, allow 22/80/443).
      nginx_multisite_ssh_disable_root:
        type: bool
        required: false
        default: true
